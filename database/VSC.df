ADD SEQUENCE "cust_seq"
  INITIAL 0
  INCREMENT 1
  CYCLE-ON-LIMIT no

ADD SEQUENCE "vehicle_seq"
  INITIAL 0
  INCREMENT 1
  CYCLE-ON-LIMIT no

ADD SEQUENCE "service_seq"
  INITIAL 1
  INCREMENT 1
  CYCLE-ON-LIMIT no

ADD SEQUENCE "payment_seq"
  INITIAL 1
  INCREMENT 1
  CYCLE-ON-LIMIT no

ADD SEQUENCE "cust_id_seq"
  INITIAL 1
  INCREMENT 1
  CYCLE-ON-LIMIT no

ADD SEQUENCE "seq_cust_id"
  INITIAL 1
  INCREMENT 1
  CYCLE-ON-LIMIT no

ADD SEQUENCE "seq_vehicle_id"
  INITIAL 1
  INCREMENT 1
  CYCLE-ON-LIMIT no

ADD TABLE "Customer"
  AREA "Schema Area"
  DUMP-NAME "customer"

ADD FIELD "customer-id" OF "Customer" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10

ADD FIELD "name" OF "Customer" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 3
  MAX-WIDTH 16
  ORDER 20

ADD FIELD "phone" OF "Customer" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 16
  ORDER 30

ADD FIELD "email" OF "Customer" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 5
  MAX-WIDTH 16
  ORDER 40

ADD FIELD "address" OF "Customer" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 6
  MAX-WIDTH 16
  ORDER 50

ADD FIELD "cbCity" OF "Customer" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 7
  MAX-WIDTH 16
  ORDER 60

ADD FIELD "city" OF "Customer" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 8
  MAX-WIDTH 16
  ORDER 70

ADD FIELD "gender" OF "Customer" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 9
  MAX-WIDTH 16
  ORDER 80

ADD INDEX "cust_id" ON "Customer" 
  AREA "Schema Area"
  PRIMARY
  INDEX-FIELD "customer-id" ASCENDING 

ADD TABLE "Payment"
  AREA "Schema Area"
  DUMP-NAME "payment"

ADD FIELD "payment-id" OF "Payment" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10

ADD FIELD "customer-id" OF "Payment" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 3
  MAX-WIDTH 4
  ORDER 20

ADD FIELD "method" OF "Payment" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 16
  ORDER 30

ADD FIELD "amount-paid" OF "Payment" AS decimal 
  FORMAT "->>,>>9.99"
  INITIAL "0"
  POSITION 5
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 40

ADD FIELD "date" OF "Payment" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  POSITION 6
  MAX-WIDTH 4
  ORDER 50

ADD FIELD "payment-status" OF "Payment" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 7
  MAX-WIDTH 16
  ORDER 60

ADD FIELD "remarks" OF "Payment" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 8
  MAX-WIDTH 16
  ORDER 70

ADD FIELD "service-id" OF "Payment" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 9
  MAX-WIDTH 4
  ORDER 80

ADD INDEX "payment-id" ON "Payment" 
  AREA "Schema Area"
  PRIMARY
  INDEX-FIELD "payment-id" ASCENDING 

ADD TABLE "Service"
  AREA "Schema Area"
  DUMP-NAME "service"

ADD FIELD "service-id" OF "Service" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10

ADD FIELD "vehicle-id" OF "Service" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 3
  MAX-WIDTH 4
  ORDER 20

ADD FIELD "service-type" OF "Service" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 16
  ORDER 30

ADD FIELD "service-date" OF "Service" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  POSITION 5
  MAX-WIDTH 4
  ORDER 40

ADD FIELD "parts-cost" OF "Service" AS decimal 
  FORMAT "->>,>>9.99"
  INITIAL "0"
  POSITION 7
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 60

ADD FIELD "feedback" OF "Service" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 9
  MAX-WIDTH 16
  ORDER 80

ADD FIELD "date-of-completion" OF "Service" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  POSITION 10
  MAX-WIDTH 4
  ORDER 90

ADD FIELD "labour-cost" OF "Service" AS decimal 
  FORMAT "->>,>>9.99"
  INITIAL "0"
  LABEL ""
  POSITION 11
  MAX-WIDTH 17
  COLUMN-LABEL ""
  DECIMALS 2
  ORDER 100

ADD FIELD "total-cost" OF "Service" AS decimal 
  FORMAT "->>,>>9.99"
  INITIAL "0"
  POSITION 12
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 110

ADD FIELD "cust-id" OF "Service" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 14
  MAX-WIDTH 4
  ORDER 120

ADD FIELD "description" OF "Service" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 15
  MAX-WIDTH 16
  ORDER 130

ADD FIELD "cost" OF "Service" AS decimal 
  FORMAT "->>,>>9.99"
  INITIAL "0"
  POSITION 16
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 140

ADD INDEX "srivice-id" ON "Service" 
  AREA "Schema Area"
  PRIMARY
  INDEX-FIELD "service-id" ASCENDING 

ADD INDEX "vehicle-id" ON "Service" 
  AREA "Schema Area"
  INDEX-FIELD "vehicle-id" ASCENDING 

ADD TABLE "Vehicle"
  AREA "Schema Area"
  DUMP-NAME "vehicle"

ADD FIELD "vehicle-id" OF "Vehicle" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10

ADD FIELD "customer-id" OF "Vehicle" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 3
  MAX-WIDTH 4
  ORDER 20

ADD FIELD "plate-number" OF "Vehicle" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 16
  ORDER 30

ADD FIELD "vehicle-type" OF "Vehicle" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 5
  MAX-WIDTH 16
  ORDER 40

ADD FIELD "make" OF "Vehicle" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 6
  MAX-WIDTH 16
  ORDER 50

ADD FIELD "model" OF "Vehicle" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 7
  MAX-WIDTH 16
  ORDER 60

ADD FIELD "year" OF "Vehicle" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 8
  MAX-WIDTH 4
  ORDER 70

ADD INDEX "vehicle-id" ON "Vehicle" 
  AREA "Schema Area"
  PRIMARY
  INDEX-FIELD "vehicle-id" ASCENDING 

ADD INDEX "cust-id" ON "Vehicle" 
  AREA "Schema Area"
  INDEX-FIELD "customer-id" ASCENDING 

.
PSC
cpstream=ISO8859-1
