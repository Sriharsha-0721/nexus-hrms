ADD TABLE "AppUser"
  AREA "Schema Area"
  DUMP-NAME "appuser"

ADD FIELD "AppUserID" OF "AppUser" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 2
  MAX-WIDTH 16
  ORDER 10

ADD FIELD "Username" OF "AppUser" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 3
  MAX-WIDTH 16
  ORDER 20

ADD FIELD "Password" OF "AppUser" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 16
  ORDER 30

ADD FIELD "Role" OF "AppUser" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 5
  MAX-WIDTH 16
  ORDER 40

ADD FIELD "LastLogin" OF "AppUser" AS datetime 
  FORMAT "99/99/9999 HH:MM:SS.SSS"
  INITIAL ?
  POSITION 6
  MAX-WIDTH 8
  ORDER 50

ADD FIELD "UserStatus" OF "AppUser" AS character 
  FORMAT "x(20)"
  INITIAL ""
  POSITION 7
  MAX-WIDTH 40
  ORDER 60

ADD INDEX "AppUserID" ON "AppUser" 
  AREA "Schema Area"
  PRIMARY
  INDEX-FIELD "AppUserID" ASCENDING 

ADD TABLE "EmployeeDetails"
  AREA "Schema Area"
  DUMP-NAME "employeedetails"

ADD FIELD "EmpID" OF "EmployeeDetails" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10

ADD FIELD "FullName" OF "EmployeeDetails" AS character 
  DESCRIPTION "Employee full name"
  FORMAT "x(50)"
  INITIAL ""
  POSITION 3
  MAX-WIDTH 100
  ORDER 20

ADD FIELD "DOB" OF "EmployeeDetails" AS date 
  DESCRIPTION "Date of birth"
  FORMAT "99/99/99"
