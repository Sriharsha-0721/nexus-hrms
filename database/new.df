  POSITION 4
  MAX-WIDTH 4
  ORDER 30

ADD FIELD "Gender" OF "EmployeeDetails" AS character 
  FORMAT "x(10)"
  INITIAL ""
  POSITION 5
  MAX-WIDTH 20
  ORDER 40

