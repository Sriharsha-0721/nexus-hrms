  FORMAT "x(100)"
  INITIAL ""
  POSITION 6
  MAX-WIDTH 200
  ORDER 50

ADD FIELD "Phone" OF "EmployeeDetails" AS character 
  FORMAT "x(15)"
  INITIAL ""
  POSITION 7
  MAX-WIDTH 30
  ORDER 60

ADD FIELD "EmailID" OF "EmployeeDetails" AS character 
  FORMAT "x(50)"
  INITIAL ""
  POSITION 8
  MAX-WIDTH 100
  ORDER 70

ADD FIELD "BankName" OF "EmployeeDetails" AS character 
  FORMAT "x(50)"
  INITIAL ""
  POSITION 9
  MAX-WIDTH 100
  ORDER 80

ADD FIELD "BankAccountNo" OF "EmployeeDetails" AS character 
  FORMAT "x(20)"
  INITIAL ""
  POSITION 10
  MAX-WIDTH 40
  ORDER 90

ADD FIELD "IFSCCode" OF "EmployeeDetails" AS character 
  FORMAT "x(20)"
  INITIAL ""
  POSITION 11
  MAX-WIDTH 40
  ORDER 100

ADD FIELD "UPPID" OF "EmployeeDetails" AS character 
  FORMAT "x(50)"
  INITIAL ""
  POSITION 12
  MAX-WIDTH 100
  ORDER 110

ADD FIELD "PAN" OF "EmployeeDetails" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 13
  MAX-WIDTH 16
  ORDER 120

